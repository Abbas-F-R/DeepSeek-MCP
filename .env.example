# DeepSeek API Settings
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Unified Model Setting (e.g. deepseek-v4-flash, deepseek-v4-pro)
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional reasoning effort (low | medium | high | max)
DEEPSEEK_REASONING_EFFORT=max

# Orchestrator Settings
DEFAULT_PROVIDER=deepseek
MAX_PARALLEL_TASKS=5
DEFAULT_TIMEOUT_MS=120000
MAX_RETRIES=3
LOG_LEVEL=info

# Workspace binding
# Normally unset: the server detects the project root from its working directory
# (walking up to .git / package.json / go.mod / pyproject.toml / Cargo.toml / .sln).
# Set this only to override that detection.
# PROJECT_ROOT=/abs/path/to/project
# Allow workspace tools to touch paths outside PROJECT_ROOT (not recommended)
# ALLOW_OUTSIDE_WORKSPACE=0

# Server logs directory (defaults to <package>/logs, never the served project)
# LOG_DIR=/abs/path/to/logs


# Memory
# Auto-capture: after every subagent run a cheap DeepSeek pass extracts durable
# facts into <project>/.agent/memory/FACTS.md. Set to 0 to store nothing automatically.
# MEMORY_AUTOCAPTURE=1
# Model used for fact extraction and log compaction (defaults to DEEPSEEK_MODEL).
# DEEPSEEK_CURATOR_MODEL=deepseek-v4-flash

# Context window a subagent's history is shaped against. The pipeline caps
# oversized tool results, prunes old ones, and only summarizes if still over 85%.
# DEEPSEEK_CONTEXT_WINDOW=128000
