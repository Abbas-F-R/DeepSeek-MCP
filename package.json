{
  "name": "deepseek-subagents",
  "version": "2.0.0",
  "description": "Claude Code plugin: delegate bounded coding sub-tasks to DeepSeek subagents that read and write the project directly, over a self-filling markdown memory",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "deepseek-subagents": "dist/index.js"
  },
  "files": [
    "dist",
    "prompts",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abbas-F-R/DeepSeek-MCP.git"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "prepare": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "npm run build && npm run test:unit && npm run test:integration",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:live": "npm run build && node --import tsx --test tests/live/*.test.ts"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "plugin",
    "deepseek",
    "subagents",
    "delegation",
    "code-review",
    "agent-memory"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "dotenv": "^16.4.7",
    "openai": "^4.86.0",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
